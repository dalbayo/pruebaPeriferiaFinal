    {
      "name": "Publicaciones",
      "description": "PublicacionController — @RequestMapping(\"/api/publicaciones\"). Requiere JWT. Autor se toma del token si el body no trae usuario.id.",
      "item": [
        {
          "name": "Listar (todas)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones?tipo=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publicaciones"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "0",
                  "description": "0=todas (default), 1=mías, 2=de otros usuarios"
